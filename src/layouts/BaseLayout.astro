---
import SEOHead from "../components/SEOHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site-data.json";
import "../styles/global.css";


const { title, description, canonicalUrl, image, jsonLd, noindex, ogType, articleMeta } = Astro.props;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, site.organization.url).toString();
---

<!doctype html>
<html lang="en" data-theme="erudika">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="global-privacy-control" content="true" />
    <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=(), interest-cohort=()" />
    <meta http-equiv="Content-Security-Policy" content="
      default-src 'self';
      script-src 'self' 'unsafe-inline' matomo.fixproperty.eu/matomo.js www.google.com/recaptcha/api.js www.gstatic.com;
      style-src 'self' 'unsafe-inline';
      img-src 'self' data: matomo.fixproperty.eu;
      connect-src 'self' paraio.com matomo.fixproperty.eu www.google.com;
      frame-ancestors 'self';
      frame-src 'self' www.google.com;
      font-src 'self' data:;
    " />
    <SEOHead title={title} description={description} canonical={canonical} image={image} jsonLd={jsonLd} ogType={ogType} articleMeta={articleMeta} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-precomposed.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="alternate" type="application/rss+xml" title="Erudika Blog" href="/rss.xml" />
    <link rel="alternate" type="application/feed+json" title="Erudika Blog" href="/feed.json" />
    <link rel="preconnect" href="//matomo.fixproperty.eu" />
    <link rel="preconnect" href="//paraio.com" />
    <script type="speculationrules">
    {
      "prefetch": [{
        "source": "document",
        "where": {
          "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": ["/cdn-cgi/*", "/404/*", "/500/*", "/503/*"] } }
          ]
        }
      }]
    }
    </script>
  </head>
  <body class="bg-base-100 min-h-screen text-base-content">
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <div class="flex flex-col min-h-screen">
      <Header />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
    
    <script define:vars={{ isDev: import.meta.env.DEV }}>
      if ("serviceWorker" in navigator) {
        if (isDev) {
          navigator.serviceWorker.getRegistrations().then((regs) =>
            regs.forEach((r) => r.unregister())
          );
        } else {
          navigator.serviceWorker.register("/sw.js");
        }
      }
    </script>
  </body>
</html>
